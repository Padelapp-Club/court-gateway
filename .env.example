# Секреты шлюза. Файл .env создаёт команда setup с правами 0600 — никому его не пересылайте.
# Пароль администратора CRM
CRM_PASSWORD=
# Секрет подключения к хабу (выдаётся хабом в обмен на одноразовый код)
GATEWAY_HUB_SECRET=
# Корпоративный прокси, если в интернет можно только через него (или hub.proxy_url в gateway.yaml)
# HTTPS_PROXY=http://proxy.example.test:3128
# NO_PROXY=crm.example.test,.lan
